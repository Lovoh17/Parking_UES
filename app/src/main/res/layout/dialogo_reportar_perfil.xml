<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/style_redondeado_blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@color/blanco"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ICONO DE ADVERTENCIA -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:contentDescription="Advertencia"
                android:src="@drawable/ic_warning"
                app:tint="@color/rojo_brillante" />

            <!-- TITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:text="¿Eliminar cuenta?"
                android:textColor="@color/rojo_brillante"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- MENSAJ DE CONFIRMACION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Esta acción eliminará permanentemente tu cuenta y todos los datos asociados. No podrás recuperar esta información."
                android:textColor="#2B2A4C"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- LISTA DE ELEMENTOS QUE SE BORRARAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:layout_marginHorizontal="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Se eliminará:"
                    android:textColor="#6D2323"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Historial de parqueos\n• Información de pago\n• Preferencias y configuraciones\n• Membresías activas"
                    android:textColor="#2B2A4C"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- CAMPO DE CONFIRMACION -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="#7D0A0A"
                app:hintTextColor="#6D2323"/>

            <!-- BOTONES CANCELAR Y ELIMINAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelarBorrarCuenta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textColor="@color/rojo_brillante"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_x"
                    app:iconGravity="textStart"
                    app:iconTint="@color/rojo_brillante"
                    app:strokeColor="@color/rojo_brillante"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmarBorrarCuenta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Eliminar cuenta"
                    android:textColor="#EEEEEE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/rojo_brillante"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_basurero"
                    app:iconGravity="textStart"
                    app:iconTint="@color/blanco" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>