<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:padding="24dp"
    tools:context=".RegistroCode">

    <!-- IMAGEN -->
    <ImageView
        android:id="@+id/imagen"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:padding="20dp"
        android:src="@drawable/ic_codigo_qr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- TITULO -->
    <TextView
        android:id="@+id/texto_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Registro Código"
        android:textColor="@color/rojo_fuerte"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imagen" />

    <!-- SUb TITOLO -->
    <TextView
        android:id="@+id/texto_subtitulo"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.9"
        android:text="Ingresa el código de 4 dígitos para registrar tu usuario en el sistema"
        android:textAlignment="center"
        android:textColor="@color/rojo_suave"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_titulo" />

    <!--  CAMPO DE TEXTO PARA REGITRAS EL CODE -->
    <EditText
        android:id="@+id/txtRegistroCode"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/fondo_digito_codigo"
        android:gravity="center"
        android:hint="0000"
        android:textColorHint="@color/rojo"
        android:inputType="number"
        android:maxLength="4"
        android:textColor="@color/rojo"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.5"
        android:nextFocusForward="@id/btnRgistrarCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_subtitulo" />


    <!--BOTON REGITRAR CODIGO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRgistrarCode"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginStart="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="100dp"
        android:layout_weight="1"
        android:backgroundTint="@color/rojo_fuerte"
        android:enabled="false"
        android:letterSpacing="0.05"
        android:text="Registrar"
        android:textColor="@color/crema_claro"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_mani_clicl_128"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/blanco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRegistroCode"
        app:strokeColor="@color/rojo_terroso"
        app:strokeWidth="1dp" />

    <!--MENSAJE PARA CODIGO REGOTRADO EXITOSAMNETE O SI HAY ALGUN PROBLEMA MOSTRAR HUBO UN ERRRO-->
    <TextView
        android:id="@+id/lblMensajeInformativo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:background="@color/blanco_80"
        android:gravity="center"
        android:padding="15dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRgistrarCode"
        tools:text="Código registrado exitosamente"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>